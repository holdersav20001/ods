        <mxCell id="legend2" value="● = UUID born (first row created).   Dashed horizontal arrows = a write that references an existing UUID on another lifeline." style="text;html=1;align=center;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
