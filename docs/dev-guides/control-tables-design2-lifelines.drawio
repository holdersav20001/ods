        <mxCell id="a2" value="route_run_id = 17&#10;pipeline.run_log (s3_batch)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;fontStyle=1;align=center;" vertex="1" parent="1">
