        <mxCell id="DFa1" value="transfer" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" source="DF-sftp" target="DF-s3r" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- SILVER -->
        <mxCell id="DF-ingest" value="Glue Spark — stage_ingest&#10;RAW_READ · SCHEMA_VALIDATE&#10;DQ_CHECK · CURATED_WRITE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#BBDEFB;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="375" y="300" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="DF-s3c"   value="S3 Curated (Silver)&#10;s3://ods-curated-{env}/date={bd}/&#10;validated canonical rows&#10;immutable partitions" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#CFD8DC;strokeColor=#546E7A;" vertex="1" parent="1"><mxGeometry x="630" y="300" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="DF-dlq"   value="S3 DLQ&#10;DQ failures" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFCDD2;strokeColor=#C62828;" vertex="1" parent="1"><mxGeometry x="630" y="430" width="160" height="50" as="geometry"/></mxCell>

