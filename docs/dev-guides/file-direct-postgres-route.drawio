        <mxCell id="DF-hist"  value="S3 Gold history&#10;full historical store&#10;Query via Athena/Spark" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#CFD8DC;strokeColor=#546E7A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1380" y="430" width="170" height="65" as="geometry"/></mxCell>

        <mxCell id="DFa8" value="upsert (stage + MERGE)" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" source="DF-pgw-c" target="DF-pg" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="DFa9" value="upsert (transformed)" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;dashed=1;" edge="1" source="DF-pgw-n" target="DF-pg" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
