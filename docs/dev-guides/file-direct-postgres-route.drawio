        <mxCell id="GDa-n-pg" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="GD-n-tx" target="GD-pg" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Recon + lineage + finalise -->
        <mxCell id="GD-recon" value="direct_postgres_count recon&#10;curated_count vs postgres rows tagged _ods_run_id&#10;→ pipeline.reconciliation_log" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF8E1;strokeColor=#F57F17;" vertex="1" parent="1">
