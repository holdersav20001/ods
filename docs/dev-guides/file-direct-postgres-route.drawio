        <mxCell id="DFa6" value="reads Silver&#10;(non-canonical)" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;dashed=1;" edge="1" source="DF-s3c" target="DF-pgw-n" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
