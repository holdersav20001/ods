        <mxCell id="ZL-sv" value="SILVER" style="text;html=1;strokeColor=#546E7A;fillColor=#CFD8DC;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#546E7A;" vertex="1" parent="1"><mxGeometry x="530"  y="68" width="110" height="28" as="geometry"/></mxCell>
        <mxCell id="ZL-gd" value="GOLD" style="text;html=1;strokeColor=#F9A825;fillColor=#FFF9C4;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#F57F17;" vertex="1" parent="1"><mxGeometry x="1235" y="68" width="110" height="28" as="geometry"/></mxCell>

