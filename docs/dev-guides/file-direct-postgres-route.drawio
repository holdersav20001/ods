        <mxCell id="DF-pgw-n" value="ods_postgres_write.py&#10;(is_canonical: false)&#10;read Silver → transform → JDBC upsert" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E1BEE7;strokeColor=#6A1B9A;dashed=1;" vertex="1" parent="1"><mxGeometry x="880" y="380" width="210" height="70" as="geometry"/></mxCell>
