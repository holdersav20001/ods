          <mxGeometry x="60" y="723" width="380" height="16" as="geometry"/>
        </mxCell>

        <mxCell id="GD-c-read" value="ods_postgres_write.py&#10;read S3 Curated (Silver)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="80" y="750" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="GD-c-merge" value="MERGE into ods.&lt;target&gt;&#10;via stage table + INSERT ON CONFLICT&#10;key_fields → upsert by business key" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="80" y="820" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="GDa-c1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="GD-c-read" target="GD-c-merge" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="GDa-yes" value="yes" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" source="GD-dec" target="GD-c-read" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ── NON-CANONICAL PATH (right) ── -->
        <mxCell id="GD-nc-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6A1B9A;dashed=1;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="620" y="720" width="400" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="GD-nc-lbl" value="Non-canonical path (is_canonical: false) — inline transform" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=9;fontStyle=3;fontColor=#6A1B9A;" vertex="1" parent="1">
          <mxGeometry x="620" y="723" width="400" height="16" as="geometry"/>
        </mxCell>

        <mxCell id="GD-n-read" value="ods_postgres_write.py&#10;read S3 Curated (Silver)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E1BEE7;strokeColor=#6A1B9A;" vertex="1" parent="1">
          <mxGeometry x="680" y="750" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="GD-n-yaml" value="load transform YAML&#10;(transform_yaml_path from dataset_config)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E1BEE7;strokeColor=#6A1B9A;" vertex="1" parent="1">
          <mxGeometry x="680" y="820" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="GD-n-tx" value="compile_transform + apply&#10;source shape → target schema&#10;field renames · type casts · drops" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E1BEE7;strokeColor=#6A1B9A;" vertex="1" parent="1">
          <mxGeometry x="680" y="890" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="GDa-n1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="GD-n-read" target="GD-n-yaml" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="GDa-n2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="GD-n-yaml" target="GD-n-tx" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="GDa-no" value="no" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" source="GD-dec" target="GD-n-read" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- MERGE POINT: Postgres write -->
        <mxCell id="GD-pg" value="Postgres ODS — ods.&lt;target&gt;&#10;UPSERT by key_fields (stage table + MERGE)&#10;CURRENT STATE ONLY — latest record per key" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E0F2F1;strokeColor=#00695C;fontStyle=1;" vertex="1" parent="1">
