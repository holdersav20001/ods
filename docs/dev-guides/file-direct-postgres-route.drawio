        <mxCell id="GDa2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="GD-pg" target="GD-recon" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="GD-lin" value="lineage: curated_to_postgres&#10;→ pipeline.lineage" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF8E1;strokeColor=#F57F17;" vertex="1" parent="1">
          <mxGeometry x="370" y="1250" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="GDa3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="GD-recon" target="GD-lin" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="GD-fin" value="finalise&#10;run_log=succeeded · file_catalogue=loaded" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="370" y="1345" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="GDa4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="GD-lin" target="GD-fin" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="GD-end" value="Postgres = current state · S3 = full history" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E0F2F1;strokeColor=#00695C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="1440" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="GDa5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="GD-fin" target="GD-end" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

