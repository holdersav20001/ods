        <mxCell id="d_le" value="row1: consumer=2, source_file=F, raw_to_curated&#10;       source_ref=s3://ods-raw/.../...csv&#10;       target_ref=s3://ods-curated/.../&#10;&lt;b&gt;row2: consumer=6, upstream=2, source_file=F, curated_to_postgres&#10;       source_ref=s3://ods-curated/.../   ← this is the curated file that was loaded&#10;       target_ref=jdbc:postgresql://.../ods.insurance_country_code&#10;       record_count=98&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#37474F;fontFamily=Courier New;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1050" y="215" width="280" height="140" as="geometry"/></mxCell>
