  <diagram name="Airflow DAG topology" id="airflow">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageScale="1" pageWidth="1700" pageHeight="900">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="Airflow DAG topology — how the 8 conceptual steps map to 4 real Airflow tasks" style="text;html=1;align=center;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="30" as="geometry"/></mxCell>
        <mxCell id="sub" value="dag_ingest_direct_postgres   (Airflow scheduler runs this on every file)" style="text;html=1;align=center;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1620" height="22" as="geometry"/></mxCell>

        <!-- The 4 Airflow tasks -->
        <mxCell id="t_init" value="&lt;b style=&quot;font-size:14px&quot;&gt;init_run&lt;/b&gt;&#10;@task (Python)&#10;runs in airflow-scheduler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="t_ingest" value="&lt;b style=&quot;font-size:14px&quot;&gt;stage_ingest&lt;/b&gt;&#10;Airflow task&#10;submits the ingestion Glue job&#10;(ods_ingestion.py — Spark)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#E65100;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="120" width="330" height="80" as="geometry"/></mxCell>
        <mxCell id="t_pg" value="&lt;b style=&quot;font-size:14px&quot;&gt;stage_postgres_write&lt;/b&gt;&#10;Airflow task (long-running)&#10;submits the load Glue job&#10;(ods_postgres_write.py — Spark)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#E65100;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="120" width="370" height="80" as="geometry"/></mxCell>
        <mxCell id="t_fin" value="&lt;b style=&quot;font-size:14px&quot;&gt;finalise&lt;/b&gt;&#10;@task (Python)&#10;trigger_rule=ALL_DONE&#10;runs even if upstream failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="120" width="240" height="80" as="geometry"/></mxCell>

        <!-- Arrows -->
        <mxCell id="a1" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="t_init" target="t_ingest"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="t_ingest" target="t_pg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="t_pg" target="t_fin"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Mapping rows: which conceptual step happens inside which Airflow task -->
        <mxCell id="m_init" value="conceptual step ① DAG start" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#2E7D32;fontFamily=Courier New;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="m_ingest" value="conceptual steps ② validate_schema · ③ DQ check · ④ transform · ⑤ reconcile t0_ingestion_count" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;fontFamily=Courier New;fontSize=10;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="370" y="220" width="330" height="40" as="geometry"/></mxCell>
        <mxCell id="m_pg" value="conceptual steps ⑥ load to postgres · ⑦ reconcile direct_postgres_count" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;fontFamily=Courier New;fontSize=10;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="790" y="220" width="370" height="40" as="geometry"/></mxCell>
        <mxCell id="m_fin" value="conceptual step ⑧ DAG end" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#2E7D32;fontFamily=Courier New;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1250" y="220" width="240" height="40" as="geometry"/></mxCell>

        <!-- run_id ownership -->
        <mxCell id="r_init" value="creates run_id=1 (orchestration)&#10;creates run_id=2 (ingestion, pre-allocated)&#10;creates run_id=6 (direct_postgres, pre-allocated)&#10;passes all 3 + file_id via XCom" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontFamily=Courier New;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="r_ingest" value="uses run_id=2 (passed via --run_id arg)&#10;writes 6 rows to run_stage_log (3 stages × 2 events)&#10;writes lineage_edge raw_to_curated&#10;writes reconciliation_log t0_ingestion_count&#10;updates file_catalogue state='curated'&#10;updates run_log row 2 status='succeeded'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontFamily=Courier New;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="370" y="280" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="r_pg" value="uses run_id=6 (passed via --run_id arg)&#10;writes 2 rows to run_stage_log (postgres_write × 2)&#10;writes 98 target rows with _ods_run_id=6&#10;writes lineage_edge curated_to_postgres (upstream=2)&#10;writes reconciliation_log direct_postgres_count&#10;updates file_catalogue state='loaded'&#10;updates run_log row 6 status='succeeded'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontFamily=Courier New;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="790" y="280" width="370" height="120" as="geometry"/></mxCell>
        <mxCell id="r_fin" value="updates run_log row 1 (orchestration)&#10;status=succeeded if all child runs succeeded;&#10;status=failed if any child failed.&#10;ended_at=NOW()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontFamily=Courier New;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1250" y="280" width="240" height="100" as="geometry"/></mxCell>

        <!-- Key facts -->
        <mxCell id="facts" value="AIRFLOW HIERARCHY  +  KEY FACTS&#10;━━━━━━━━━━━━━━━━━━━━━━━&#10;• Airflow hierarchy:   DAG  →  DagRun  →  TaskInstance.&#10;     – DAG  = the workflow definition (this Python file: dag_ingest_direct_postgres).&#10;     – DagRun  = one execution of the DAG for one file (unique dag_run_id, scheduled or manually triggered).&#10;     – TaskInstance  = one execution of a single task within that DagRun. Below = 4 task instances per DagRun.&#10;• 4 Airflow tasks, NOT 8. Conceptual stages 2–5 all run inside the one stage_ingest task (one Glue/Spark job). Stages 6–7 run inside stage_postgres_write.&#10;• 2 Glue jobs in total. Each one Spark job performs MULTIPLE stages internally. Stages are run_stage_log rows, not Airflow tasks.&#10;• 3 run_log rows, allocated by init_run UPFRONT (this DAG pre-mints UUIDs). The Glue jobs receive their run_id via Airflow XCom + a --run_id CLI arg. (Other DAGs mint run_ids inside the Glue job; both patterns are valid.)&#10;• finalise uses trigger_rule=ALL_DONE so it always runs — even if a Glue job failed — to close the orchestration row with the right status." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#37474F;fontSize=11;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1620" height="220" as="geometry"/></mxCell>

        <!-- Inside the Glue container -->
        <mxCell id="inside_lbl" value="INSIDE the Glue job (run by stage_ingest) — stages are Python function calls, not Airflow tasks" style="text;html=1;align=center;fontSize=12;fontStyle=1;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="1620" height="22" as="geometry"/></mxCell>
        <mxCell id="inside" value="ods_ingestion.py (the Spark job that stage_ingest submits):&#10;    ods_pipeline.stages.start(conn, run_id=2, stage='validate_schema', ...)&#10;    # ... validate schema ...&#10;    ods_pipeline.stages.finish(conn, run_id=2, stage='validate_schema', status='succeeded', event_type='stage_completed')&#10;    ods_pipeline.stages.start(conn, run_id=2, stage='dq_check', ...)&#10;    # ... run DQ rules, split good/bad rows, write bad rows to S3 DLQ ...&#10;    ods_pipeline.stages.finish(conn, run_id=2, stage='dq_check', ...)&#10;    ods_pipeline.stages.start(conn, run_id=2, stage='transform', ...)&#10;    # ... apply transform.yaml mappings ...&#10;    ods_pipeline.stages.finish(conn, run_id=2, stage='transform', ...)&#10;    # ── ingestion finalise ──&#10;    ods_pipeline.lineage.write_edge(conn, consumer_run_id=2, source_file_id=F, edge_type='raw_to_curated', ...)&#10;    ods_pipeline.reconciliation.write_check(conn, check_type='t0_ingestion_count', run_id=2, source_count=100, accounted_count=98, status='ok')&#10;    ods_pipeline.files.update_catalogue(conn, file_id=F, state='curated', last_run_id=2)&#10;    ods_pipeline.runs.update(conn, run_id=2, status='succeeded', record_count_source=100, record_count_dq_pass=98, record_count_dq_fail=2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;fontFamily=Courier New;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="695" width="1620" height="210" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
