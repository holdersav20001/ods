<mxfile host="app.diagrams.net">
  <diagram name="File-to-Postgres Flow" id="f2p">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="File → Postgres route — stages, configs, and the control-table paper trail" style="text;html=1;align=center;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1620" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="orange = stage / task    blue = data artifact (S3 / Postgres)    yellow = YAML config    green = DAG boundary    pink = reconciliation    grey = control-plane table" style="text;html=1;align=center;fontSize=11;fontStyle=2;fillColor=#F5F5F5;strokeColor=#999;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1620" height="22" as="geometry"/>
        </mxCell>

        <!-- ===== CONFIGURATION LANE (NOW ABOVE DAG) ===== -->
        <mxCell id="lane_cfg" value="CONFIGURATION  (YAML inputs that drive each stage)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFB300;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1620" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="cfg_schema" value="schema.yaml&#10;(expected columns,&#10;types, required)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="135" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="cfg_dq" value="dq_rules.yaml&#10;(hard_blocks,&#10;soft_warns)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="135" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="cfg_xform" value="transform.yaml&#10;(field mappings,&#10;type coercions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="135" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="cfg_recon" value="dataset_config&#10;(recon_tolerance_records,&#10;recon_tolerance_pct)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="135" width="160" height="70" as="geometry"/>
        </mxCell>

        <!-- ===== DAG LANE ===== -->
        <mxCell id="lane_data" value="DAG  (tasks + data artifacts they read/write)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="245" width="1620" height="220" as="geometry"/>
        </mxCell>

        <!-- DAG start -->
        <mxCell id="dag_start" value="&lt;b style=&quot;font-size:22px;color:#1B5E20&quot;&gt;1&lt;/b&gt;&amp;nbsp; DAG start&#10;(orchestration run)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="130" height="50" as="geometry"/>
        </mxCell>

        <!-- S3 raw -->
        <mxCell id="s3raw" value="📄 S3 raw&#10;(immutable source file)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="350" width="140" height="60" as="geometry"/>
        </mxCell>

        <!-- raw_read + schema_validate (combined into step 2) -->
        <mxCell id="schema" value="&lt;b style=&quot;font-size:22px;color:#BF360C&quot;&gt;2&lt;/b&gt;&amp;nbsp; raw_read&#10;+ schema_validate" style="shape=process;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#E65100;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="350" width="140" height="60" as="geometry"/>
        </mxCell>

        <!-- dq_check -->
        <mxCell id="dq" value="&lt;b style=&quot;font-size:22px;color:#BF360C&quot;&gt;3&lt;/b&gt;&amp;nbsp; dq_check&#10;(row-level)" style="shape=process;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#E65100;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="350" width="140" height="60" as="geometry"/>
        </mxCell>

        <!-- curated_write incl. inline enrich -->
        <mxCell id="transform" value="&lt;b style=&quot;font-size:22px;color:#BF360C&quot;&gt;4&lt;/b&gt;&amp;nbsp; curated_write&#10;(enrich inline,&#10;no stage row)" style="shape=process;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#E65100;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="350" width="140" height="60" as="geometry"/>
        </mxCell>

        <!-- S3 curated -->
        <mxCell id="s3cur" value="📦 S3 curated&#10;(good rows, Parquet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="320" width="140" height="60" as="geometry"/>
        </mxCell>

        <!-- S3 DLQ -->
        <mxCell id="s3dlq" value="🗑 S3 DLQ&#10;(rejected rows + reasons)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="400" width="140" height="55" as="geometry"/>
        </mxCell>

        <!-- load -->
        <mxCell id="load" value="&lt;b style=&quot;font-size:22px;color:#BF360C&quot;&gt;6&lt;/b&gt;&amp;nbsp; load to postgres&#10;(stamps _ods_*)" style="shape=process;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#E65100;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="990" y="350" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- postgres target -->
        <mxCell id="pg" value="💾 ods.&lt;target&gt;&#10;(_ods_file_id, _ods_run_id)" style="shape=cylinder3;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#E0F2F1;strokeColor=#00695C;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="340" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- DAG end -->
        <mxCell id="dag_end" value="&lt;b style=&quot;font-size:22px;color:#1B5E20&quot;&gt;8&lt;/b&gt;&amp;nbsp; DAG end&#10;(close orchestration)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1500" y="360" width="130" height="50" as="geometry"/>
        </mxCell>

        <!-- Config → stage arrows (downward) -->
        <mxCell id="cfg_e1" style="endArrow=classic;html=1;strokeColor=#F9A825;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cfg_schema" target="schema"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cfg_e2" style="endArrow=classic;html=1;strokeColor=#F9A825;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cfg_dq" target="dq"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cfg_e3" style="endArrow=classic;html=1;strokeColor=#F9A825;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cfg_xform" target="transform"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cfg_e4" style="endArrow=classic;html=1;strokeColor=#F9A825;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cfg_recon" target="load"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- DAG start → first data step -->
        <mxCell id="dag_start_arrow" style="endArrow=classic;html=1;strokeColor=#2E7D32;strokeWidth=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dag_start" target="s3raw"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- last step → DAG end -->
        <mxCell id="dag_end_arrow" style="endArrow=classic;html=1;strokeColor=#2E7D32;strokeWidth=1;dashed=1;" edge="1" parent="1" source="pg" target="dag_end"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- DAG horizontal data flow edges -->
        <mxCell id="ed1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#1565C0;" edge="1" parent="1" source="s3raw" target="schema"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed2" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#1565C0;" edge="1" parent="1" source="schema" target="dq"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed3" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#1565C0;" edge="1" parent="1" source="dq" target="transform"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed3b" value="good rows" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#1565C0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;" edge="1" parent="1" source="transform" target="s3cur"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed4" value="bad rows" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#C62828;exitX=1;exitY=0.7;exitDx=0;exitDy=0;dashed=1;" edge="1" parent="1" source="dq" target="s3dlq"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed5" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#1565C0;" edge="1" parent="1" source="s3cur" target="load"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed6" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#1565C0;" edge="1" parent="1" source="load" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== RECONCILIATION LANE ===== -->
        <mxCell id="lane_recon" value="RECONCILIATION  (counts the stages, writes verdict row)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#AD1457;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="485" width="1620" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="recon_t0" value="&lt;b style=&quot;font-size:22px;color:#880E4F&quot;&gt;5&lt;/b&gt;&amp;nbsp; reconcile&#10;t0_ingestion_count&#10;(source vs accounted)" style="shape=process;rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#AD1457;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="540" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="recon_pg" value="&lt;b style=&quot;font-size:22px;color:#880E4F&quot;&gt;7&lt;/b&gt;&amp;nbsp; reconcile&#10;direct_postgres_count&#10;(curated vs target rows)" style="shape=process;rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#AD1457;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="540" width="180" height="70" as="geometry"/>
        </mxCell>

        <!-- recon reads counts from curated & target (upward, dashed pink) -->
        <mxCell id="re1" style="endArrow=classic;html=1;strokeColor=#AD1457;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="recon_t0" target="s3cur"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re1lbl" value="counts" style="text;html=1;align=center;fontSize=9;fontStyle=2;fontColor=#AD1457;" vertex="1" parent="1">
          <mxGeometry x="700" y="490" width="60" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="re2" style="endArrow=classic;html=1;strokeColor=#AD1457;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="recon_pg" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re2lbl" value="counts" style="text;html=1;align=center;fontSize=9;fontStyle=2;fontColor=#AD1457;" vertex="1" parent="1">
          <mxGeometry x="1090" y="490" width="60" height="18" as="geometry"/>
        </mxCell>

        <!-- ===== CONTROL-TABLE LANE ===== -->
        <mxCell id="lane_ctrl" value="CONTROL-PLANE WRITES  (the paper trail)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#37474F;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="665" width="1620" height="400" as="geometry"/>
        </mxCell>

        <!-- six control tables -->
        <mxCell id="ct_fc" value="pipeline.file_catalogue&#10;━━━━━━━━━━━━━━━━&#10;state: received → curated → loaded&#10;file_id, sftp_path, s3_raw_path,&#10;s3_curated_path, last_run_id" style="shape=cylinder3;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#37474F;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="715" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="ct_rl" value="pipeline.run_log&#10;━━━━━━━━━━━━━━━━&#10;3 rows per file:&#10; • orchestration (DAG)&#10; • ingestion&#10; • direct_postgres&#10;orchestrators[] = scheduler link" style="shape=cylinder3;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#37474F;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="715" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="ct_sl" value="pipeline.run_stage_log&#10;━━━━━━━━━━━━━━━━&#10;2 rows per stage&#10;(start, finish)&#10;event_type, status, attempt_number" style="shape=cylinder3;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#37474F;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="715" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="ct_le" value="pipeline.lineage_edge&#10;━━━━━━━━━━━━━━━━&#10;2 rows per file:&#10; • raw_to_curated&#10; • curated_to_postgres&#10;consumer_run_id, upstream_run_id,&#10;source_file_id" style="shape=cylinder3;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#37474F;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="715" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ct_rc" value="pipeline.reconciliation_log&#10;━━━━━━━━━━━━━━━━&#10;2 rows per file:&#10; • t0_ingestion_count&#10; • direct_postgres_count&#10;source_count, accounted_count,&#10;postgres_count, status" style="shape=cylinder3;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#37474F;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1140" y="715" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ct_pa" value="pipeline.file_processing_attempt&#10;━━━━━━━━━━━━━━━━&#10;(idempotency ledger&#10;for retries)" style="shape=cylinder3;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#37474F;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1420" y="715" width="220" height="110" as="geometry"/>
        </mxCell>

        <!-- Stage → control table writes (dashed dark grey) -->
        <mxCell id="w_dq_sl" style="endArrow=classic;html=1;dashed=1;strokeColor=#37474F;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dq" target="ct_sl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w_schema_sl" style="endArrow=classic;html=1;dashed=1;strokeColor=#37474F;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="schema" target="ct_sl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w_xform_sl" style="endArrow=classic;html=1;dashed=1;strokeColor=#37474F;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="transform" target="ct_sl"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="w_land_fc" style="endArrow=classic;html=1;dashed=1;strokeColor=#37474F;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3raw" target="ct_fc"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="w_xform_le" style="endArrow=classic;html=1;dashed=1;strokeColor=#37474F;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="transform" target="ct_le"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w_xform_fc" style="endArrow=classic;html=1;dashed=1;strokeColor=#37474F;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="transform" target="ct_fc"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="w_recon_rc1" style="endArrow=classic;html=1;dashed=1;strokeColor=#37474F;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="recon_t0" target="ct_rc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w_recon_rc2" style="endArrow=classic;html=1;dashed=1;strokeColor=#37474F;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="recon_pg" target="ct_rc"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="w_load_le" style="endArrow=classic;html=1;dashed=1;strokeColor=#37474F;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="load" target="ct_le"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w_load_sl" style="endArrow=classic;html=1;dashed=1;strokeColor=#37474F;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="load" target="ct_sl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w_load_rl" style="endArrow=classic;html=1;dashed=1;strokeColor=#37474F;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="load" target="ct_rl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w_load_fc" style="endArrow=classic;html=1;dashed=1;strokeColor=#37474F;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="load" target="ct_fc"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- DAG start / end → run_log (green) -->
        <mxCell id="w_dag_start" style="endArrow=classic;html=1;dashed=1;strokeColor=#2E7D32;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dag_start" target="ct_rl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w_dag_start_lbl" value="INSERT orchestration row&#10;status=running" style="text;html=1;align=center;fontSize=9;fontStyle=2;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="170" y="650" width="180" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="w_dag_end" style="endArrow=classic;html=1;dashed=1;strokeColor=#2E7D32;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dag_end" target="ct_rl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w_dag_end_lbl" value="UPDATE status=succeeded&#10;ended_at=NOW()" style="text;html=1;align=center;fontSize=9;fontStyle=2;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="1410" y="650" width="180" height="30" as="geometry"/>
        </mxCell>

        <!-- Which stage writes which table -->
        <mxCell id="writes_box" value="Which stage writes which table" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontStyle=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="855" width="1560" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="writes_table" value="DAG start          →  run_log (orchestration, status=running)&#10;Landing            →  file_catalogue (state=received)&#10;Ingestion starts   →  run_log (ingestion)&#10;Each stage         →  run_stage_log (start + finish), all attempts&#10;DQ check           →  S3 DLQ + run_stage_log; record_count_dq_fail on run_log&#10;Transform finishes →  file_catalogue (state=curated), lineage_edge (raw_to_curated), reconciliation_log (t0_ingestion_count), run_log (succeeded)&#10;Load starts        →  run_log (direct_postgres)&#10;Load finishes      →  ods.&lt;target&gt; rows with _ods_file_id + _ods_run_id, lineage_edge (curated_to_postgres), reconciliation_log (direct_postgres_count), file_catalogue (state=loaded), run_log (succeeded)&#10;DAG end            →  run_log (orchestration UPDATE status=succeeded)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontFamily=Courier New;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="890" width="1560" height="170" as="geometry"/>
        </mxCell>

        <!-- Footer note -->
        <mxCell id="footer" value="Dashed yellow = config-feeds-stage    Dashed pink = reconcile reads counts    Dashed dark grey = stage writes control table    Dashed green = DAG boundary" style="text;html=1;align=center;fontSize=10;fontStyle=2;fontColor=#555;" vertex="1" parent="1">
          <mxGeometry x="40" y="1075" width="1620" height="20" as="geometry"/>
        </mxCell>

        <!-- Real-code stage callout -->
        <mxCell id="stages_callout" value="REAL CODE → STAGE ROWS&#10;━━━━━━━━━━━━━━━━━━━━━━&#10;Ingestion Glue job (one Spark process under stage_ingest task) emits FOUR run_stage_log stage rows in this order:&#10;     1) raw_read           — load source file from S3 raw into a DataFrame&#10;     2) schema_validate    — file-level check vs schema.yaml; mismatch aborts the WHOLE file&#10;     3) dq_check           — row-level rules; bad rows → S3 DLQ, good rows continue&#10;     4) curated_write      — applies the inline enrich (transform.yaml field mappings) AND writes the Parquet&#10;Note:  enrich is pure Python inside curated_write — it is NOT its own stage_log row.&#10;Load Glue job (one Spark process under stage_postgres_write task) emits ONE stage row: postgres_write." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;fontSize=11;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1100" width="1620" height="180" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

