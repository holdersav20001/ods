        <mxCell id="d_rc" value="run=2 | t0_ingestion_count    | source=100, accounted=98, ok&#10;&lt;b&gt;run=6 | direct_postgres_count | source=98, postgres=98, ok&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#37474F;fontFamily=Courier New;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1350" y="215" width="310" height="80" as="geometry"/></mxCell>
        <mxCell id="note" value="WHAT JUST HAPPENED  (load finalise — symmetric to step 5)&#10;━━━━━━━━━━━━━━━━━━━━━━━&#10;Load task wrote FOUR things atomically:&#10;  1) reconciliation_log row: source_count=98 (curated), postgres_count=98 (target table), status='ok'.&#10;  2) lineage_edge row: consumer=6, upstream=2, source_file=F, edge_type='curated_to_postgres' — BOTH parents set (data parent + file parent).&#10;  3) file_catalogue UPDATE: state='loaded' (terminal success), last_run_id=6.&#10;  4) run_log P UPDATE: status='succeeded', record_count_source=98, record_count_target=98, ended_at=NOW().&#10;The full lineage chain now exists: file F → run I → run P → ods.&lt;target&gt;." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#AD1457;fontSize=11;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="335" width="1620" height="200" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

