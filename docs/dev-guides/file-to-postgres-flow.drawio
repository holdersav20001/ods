        <mxCell id="lbl_sl" value="pipeline.run_stage_log" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontStyle=1;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="170" width="240" height="40" as="geometry"/></mxCell>
        <mxCell id="d_sl" value="2 × validate_schema, dq_check, transform&#10;6 × postgres_write&#10;(8 rows total = 4 stages × 2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF;strokeColor=#37474F;fontFamily=Courier New;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="790" y="215" width="240" height="80" as="geometry"/></mxCell>
