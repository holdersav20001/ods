          <mxGeometry x="40" y="30" width="760" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="Key idea: input_edge is the relationship row. The actual input is source_file_id for raw files, or upstream_output_link_id for a previous output." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;align=left;spacing=10;fontSize=13" vertex="1" parent="1">
