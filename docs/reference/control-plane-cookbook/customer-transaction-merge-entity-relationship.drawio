        <mxCell id="sink_out" value="cp.output_link&#xa;-----------------------------&#xa;PK output_link_id = O_CT_TARGET&#xa;FK consumer_run_id = R_CT_SINK&#xa;edge_type = canonical_to_sink&#xa;sink_type = postgres&#xa;target_ref.path = postgres://ods/customer_transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=10;fontSize=13" vertex="1" parent="1">
