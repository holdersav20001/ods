<mxfile host="app.diagrams.net">
  <diagram id="customer-transaction-merge-er" name="Customer Transaction Merge ER">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Customer + transaction merge - entity relationship model" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="850" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="Merge pattern: two upstream output_link rows are consumed by two input_edge rows to produce one merged output_link. The Postgres sink then consumes that merged output_link." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;align=left;spacing=10;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="930" y="25" width="760" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cust_out" value="cp.output_link&#xa;-----------------------------&#xa;PK output_link_id = O_CUSTOMER_SILVER&#xa;dataset = customer&#xa;edge_type = curated_to_canonical&#xa;target_ref.path = s3://silver/customer/2026-05-30.parquet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=10;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="390" height="170" as="geometry"/>
        </mxCell>
