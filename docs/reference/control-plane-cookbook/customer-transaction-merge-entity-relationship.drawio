        <mxCell id="edge_tx" value="cp.input_edge&#xa;-----------------------------&#xa;PK input_edge_id = E_MERGE_TRANSACTION&#xa;FK output_link_id = O_MERGED_SILVER&#xa;FK upstream_output_link_id = O_TRANSACTION_SILVER&#xa;input_reference_type = output_link&#xa;input_role = transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=10;fontSize=13" vertex="1" parent="1">
