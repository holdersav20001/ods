          <mxGeometry x="40" y="390" width="390" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="merge_run" value="cp.run_log&#xa;-----------------------------&#xa;PK run_id = R_MERGE&#xa;workflow_run_id = WF_CT_20260530&#xa;pipeline_type = merge&#xa;dataset = customer_transaction&#xa;status = succeeded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=10;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="520" y="260" width="340" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="merge_out" value="cp.output_link&#xa;-----------------------------&#xa;PK output_link_id = O_MERGED_SILVER&#xa;FK consumer_run_id = R_MERGE&#xa;edge_type = merge_to_canonical&#xa;target_ref.path = s3://silver/customer_transaction/2026-05-30.parquet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=10;fontSize=13" vertex="1" parent="1">
