          <mxGeometry x="40" y="20" width="680" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Canonical and non-canonical files converge into silver canonical data before gold history/current projections." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="42" y="60" width="950" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="raw-label" value="RAW / BRONZE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FED7AA;strokeColor=#EA580C;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="230" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="silver-label" value="SILVER" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E2E8F0;strokeColor=#64748B;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="575" y="130" width="230" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="gold-label" value="GOLD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1060" y="130" width="230" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="canonical-file" value="Canonical file&#xa;source columns already match contract" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFFFF;strokeColor=#64748B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="230" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="noncanonical-file" value="Non-canonical file&#xa;source-specific names and formats" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFFFF;strokeColor=#64748B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="390" width="230" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="raw-bucket" value="S3 raw&#xa;original bytes retained exactly&#xa;file_id + md5 + business_date" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FED7AA;strokeColor=#EA580C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="585" width="230" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="identity" value="Identity standardization&#xa;add ODS metadata&#xa;schema + DQ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="420" y="220" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="transform" value="Transformation mapping&#xa;transform.yaml&#xa;rename, cast, derive, require" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#64748B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="390" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="silver-table" value="S3 silver canonical Parquet&#xa;append-only technical history&#xa;_ods_file_id, _ods_run_id, _ods_ingested_at" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E2E8F0;strokeColor=#64748B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="575" y="585" width="260" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="gold-history" value="S3 gold history&#xa;all canonical versions&#xa;partitioned for replay, audit and rebuild" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="220" width="260" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="gold-current" value="Gold current projection&#xa;one latest row per key&#xa;merge rules from contract.key_fields" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="405" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="postgres" value="Postgres current serving table&#xa;latest merged data only&#xa;no full history burden" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="585" width="260" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="history-note" value="If consumers need history in SQL, expose a separate history table or query S3/Athena. Do not overload the current table." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="1320" y="585" width="210" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="control" value="Control plane evidence&#xa;dataset_config declares route and keys; reconciliation proves counts at raw to silver, silver to gold, and gold current to Postgres" style="shape=datastore;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#FFFBEB;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="790" width="1450" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="canonical route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#64748B;" edge="1" parent="1" source="canonical-file" target="identity"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="non-canonical route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#64748B;" edge="1" parent="1" source="noncanonical-file" target="transform"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#EA580C;" edge="1" parent="1" source="canonical-file" target="raw-bucket"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#EA580C;" edge="1" parent="1" source="noncanonical-file" target="raw-bucket"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#64748B;" edge="1" parent="1" source="identity" target="silver-table"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#64748B;" edge="1" parent="1" source="transform" target="silver-table"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="append full canonical history" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#D97706;" edge="1" parent="1" source="silver-table" target="gold-history"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="derive latest per key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#D97706;" edge="1" parent="1" source="gold-history" target="gold-current"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="merge/upsert latest only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=3;strokeColor=#16A34A;" edge="1" parent="1" source="gold-current" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
