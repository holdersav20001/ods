<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Claude">
  <diagram id="pipeline-table-write-sequence" name="Control Table Write Order">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="seq-title" value="pipeline.* — Control Table Write Order (File Ingestion)" style="text;html=1;fontStyle=1;fontSize=15;fillColor=none;strokeColor=none;align=left;fontColor=#1F5C8B;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="seq-rule" value="Golden rule: file_catalogue creates file_id once in Phase 1. Every subsequent phase receives file_id and run_id explicitly and writes its own table evidence before advancing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1300" height="44" as="geometry"/>
        </mxCell>

        <!-- PHASE 1 -->
        <mxCell id="p1" value="① Discover file" style="swimlane;html=1;rounded=1;fontStyle=1;startSize=36;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="270" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="p1-own" value="dag_drop_to_raw" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="p1">
          <mxGeometry x="16" y="44" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p1-c1" value="&lt;b&gt;file_catalogue&lt;/b&gt;&#xa;UPSERT by domain / dataset / file_md5&#xa;Generates file_id (UUID)&#xa;Sets: sftp_path, s3_raw_path,&#xa;business_date, source_row_count,&#xa;md5_hex, size_bytes&#xa;state = &#39;registered&#39;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="p1">
          <mxGeometry x="16" y="72" width="238" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="p1-c2" value="&lt;b&gt;Trigger downstream&lt;/b&gt;&#xa;Pass in conf:&#xa;file_id, domain, dataset,&#xa;business_date, s3_raw_path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="p1">
          <mxGeometry x="16" y="232" width="238" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p1-note" value="No run_log row yet.&#xa;run_id is generated by dag_ingest." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;fontSize=10;spacingLeft=10;fontStyle=2;" vertex="1" parent="p1">
          <mxGeometry x="16" y="340" width="238" height="50" as="geometry"/>
        </mxCell>

        <!-- PHASE 2 -->
        <mxCell id="p2" value="② Open run" style="swimlane;html=1;rounded=1;fontStyle=1;startSize=36;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="130" width="270" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="p2-own" value="dag_ingest — init_run + runs.start" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="p2">
          <mxGeometry x="16" y="44" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p2-c1" value="&lt;b&gt;run_log&lt;/b&gt;&#xa;INSERT run_id (UUID)&#xa;status = &#39;started&#39;&#xa;pipeline_type = &#39;file&#39;&#xa;file_id (FK → file_catalogue)&#xa;domain, dataset, business_date&#xa;airflow_dag_id, airflow_run_id&#xa;spark_app_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="p2">
          <mxGeometry x="16" y="72" width="238" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="p2-c2" value="&lt;b&gt;file_catalogue&lt;/b&gt;&#xa;UPDATE state = &#39;ingesting&#39;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="p2">
          <mxGeometry x="16" y="248" width="238" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p2-note" value="Idempotency: if run_id already exists&#xa;with status=succeeded, skip the job." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;fontSize=10;spacingLeft=10;fontStyle=2;" vertex="1" parent="p2">
          <mxGeometry x="16" y="326" width="238" height="50" as="geometry"/>
        </mxCell>

        <!-- PHASE 3 -->
        <mxCell id="p3" value="③ Execute stages" style="swimlane;html=1;rounded=1;fontStyle=1;startSize=36;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="130" width="270" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="p3-own" value="Glue Spark — stage_ingest (stage_scope)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="p3">
          <mxGeometry x="16" y="44" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p3-c1" value="&lt;b&gt;stage_log&lt;/b&gt; (via stage_scope context manager)&#xa;One INSERT per stage:&#xa;• RAW_READ&#xa;• SCHEMA_VALIDATE&#xa;• DQ_CHECK&#xa;• CURATED_WRITE&#xa;Fields: stage, status, input_ref,&#xa;output_ref, record_count_in,&#xa;record_count_out, error_detail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="p3">
          <mxGeometry x="16" y="72" width="238" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="p3-note" value="stage_scope() auto-writes&#xa;status=succeeded or failed&#xa;on context manager exit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;fontSize=10;spacingLeft=10;fontStyle=2;" vertex="1" parent="p3">
          <mxGeometry x="16" y="268" width="238" height="55" as="geometry"/>
        </mxCell>

        <!-- PHASE 4 -->
        <mxCell id="p4" value="④ Finalise ingest" style="swimlane;html=1;rounded=1;fontStyle=1;startSize=36;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="910" y="130" width="270" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="p4-own" value="Glue — finalise_success()" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="p4">
          <mxGeometry x="16" y="44" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p4-c1" value="&lt;b&gt;lineage&lt;/b&gt;&#xa;INSERT edge&#xa;edge_type = &#39;raw_to_curated&#39;&#xa;source_ref = s3://ods-raw-*/&#xa;target_ref = s3://ods-curated-*/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="p4">
          <mxGeometry x="16" y="72" width="238" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p4-c2" value="&lt;b&gt;reconciliation_log&lt;/b&gt;&#xa;INSERT check_type = &#39;t0_input_count&#39;&#xa;source_count, status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="p4">
          <mxGeometry x="16" y="198" width="238" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p4-c3" value="&lt;b&gt;file_catalogue&lt;/b&gt;&#xa;UPDATE state = &#39;curated&#39;&#xa;curated_uri, completed_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="p4">
          <mxGeometry x="16" y="294" width="238" height="75" as="geometry"/>
        </mxCell>

        <!-- PHASE 5 -->
        <mxCell id="p5" value="⑤ Publish to Kafka" style="swimlane;html=1;rounded=1;fontStyle=1;startSize=36;fillColor=#e1d5e7;strokeColor=#6A1B9A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="130" width="270" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="p5-own" value="stage_publish — ods_s3_publish.py" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="p5">
          <mxGeometry x="16" y="44" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p5-c1" value="&lt;b&gt;publish_stage&lt;/b&gt;&#xa;INSERT per run:&#xa;run_id, topic,&#xa;kafka_offset_start,&#xa;kafka_offset_end,&#xa;record_count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6A1B9A;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="p5">
          <mxGeometry x="16" y="72" width="238" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p5-c2" value="&lt;b&gt;reconciliation_log&lt;/b&gt;&#xa;INSERT check_type = &#39;t0_publish_count&#39;&#xa;source_count, kafka_count,&#xa;discrepancy_count, status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="p5">
          <mxGeometry x="16" y="208" width="238" height="95" as="geometry"/>
        </mxCell>

        <!-- PHASE 6 -->
        <mxCell id="p6" value="⑥ Close run" style="swimlane;html=1;rounded=1;fontStyle=1;startSize=36;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1490" y="130" width="270" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="p6-own" value="finalise (Airflow task)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="p6">
          <mxGeometry x="16" y="44" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p6-c1" value="&lt;b&gt;reconciliation_log&lt;/b&gt;&#xa;INSERT check_type = &#39;dual_sink_parity&#39;&#xa;current_count, history_count,&#xa;discrepancy_count, status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="p6">
          <mxGeometry x="16" y="72" width="238" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p6-c2" value="&lt;b&gt;run_log&lt;/b&gt;&#xa;UPDATE status = &#39;succeeded&#39;&#xa;record_count_source,&#xa;record_count_dq_pass,&#xa;record_count_dq_fail,&#xa;completed_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="p6">
          <mxGeometry x="16" y="188" width="238" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p6-c3" value="&lt;b&gt;file_catalogue&lt;/b&gt;&#xa;UPDATE state = &#39;completed&#39;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="p6">
          <mxGeometry x="16" y="324" width="238" height="60" as="geometry"/>
        </mxCell>

        <!-- flow arrows between phases -->
        <mxCell id="fa1" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" source="p1" target="p2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa2" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" source="p2" target="p3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa3" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" source="p3" target="p4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa4" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" source="p4" target="p5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa5" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" source="p5" target="p6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="table-schemas" name="Table Schema Quick-Ref">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="T-title" value="pipeline.* — Table Schema Quick Reference" style="text;html=1;fontStyle=1;fontSize=15;fillColor=none;strokeColor=none;align=left;fontColor=#1F5C8B;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="36" as="geometry"/>
        </mxCell>

        <!-- file_catalogue -->
        <mxCell id="T-fc" value="&lt;b&gt;pipeline.file_catalogue&lt;/b&gt;&#xa;file_id UUID PK&#xa;domain, dataset, business_date&#xa;sftp_path, s3_raw_path, curated_uri&#xa;md5_hex, size_bytes&#xa;source_row_count&#xa;state: registered → ingesting → curated → completed&#xa;registered_at, completed_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="260" height="180" as="geometry"/>
        </mxCell>

        <!-- run_log -->
        <mxCell id="T-rl" value="&lt;b&gt;pipeline.run_log&lt;/b&gt;&#xa;run_id UUID PK&#xa;file_id FK → file_catalogue&#xa;pipeline_type, domain, dataset, business_date&#xa;status: started → succeeded / failed&#xa;record_count_source&#xa;record_count_dq_pass, record_count_dq_fail&#xa;airflow_dag_id, airflow_run_id, spark_app_id&#xa;started_at, completed_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="80" width="260" height="200" as="geometry"/>
        </mxCell>

        <!-- stage_log -->
        <mxCell id="T-sl" value="&lt;b&gt;pipeline.stage_log&lt;/b&gt;&#xa;id SERIAL PK&#xa;run_id FK → run_log&#xa;stage: RAW_READ | SCHEMA_VALIDATE |&#xa;  DQ_CHECK | CURATED_WRITE | ...&#xa;status: succeeded | failed | skipped&#xa;input_ref, output_ref&#xa;record_count_in, record_count_out&#xa;error_detail&#xa;started_at, completed_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="270" height="210" as="geometry"/>
        </mxCell>

        <!-- lineage -->
        <mxCell id="T-ln" value="&lt;b&gt;pipeline.lineage&lt;/b&gt;&#xa;id SERIAL PK&#xa;run_id FK → run_log&#xa;file_id FK → file_catalogue&#xa;edge_type: raw_to_curated | ...&#xa;source_ref (s3 URI)&#xa;target_ref (s3 URI)&#xa;recorded_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="890" y="80" width="260" height="180" as="geometry"/>
        </mxCell>

        <!-- publish_stage -->
        <mxCell id="T-ps" value="&lt;b&gt;pipeline.publish_stage&lt;/b&gt;&#xa;id SERIAL PK&#xa;run_id FK → run_log&#xa;topic (Kafka topic name)&#xa;kafka_offset_start&#xa;kafka_offset_end&#xa;record_count&#xa;published_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6A1B9A;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1170" y="80" width="260" height="175" as="geometry"/>
        </mxCell>

        <!-- reconciliation_log -->
        <mxCell id="T-rcl" value="&lt;b&gt;pipeline.reconciliation_log&lt;/b&gt;&#xa;id SERIAL PK&#xa;check_type: t0_input_count | t0_publish_count |&#xa;  dual_sink_parity | current_history_row_value&#xa;run_id FK → run_log&#xa;domain, dataset, business_date&#xa;window_start, window_end&#xa;source_count, kafka_count, postgres_count&#xa;discrepancy_count, discrepancy_pct&#xa;status: ok | pending | failed&#xa;detail (JSON for row-level checks)&#xa;checked_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;align=left;fontSize=11;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1450" y="80" width="290" height="260" as="geometry"/>
        </mxCell>

        <!-- FK arrows -->
        <mxCell id="Tf1" value="FK file_id" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;dashed=1;" edge="1" source="T-rl"  target="T-fc"  parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="Tf2" value="FK run_id"  style="edgeStyle=orthogonalEdgeStyle;fontSize=9;dashed=1;" edge="1" source="T-sl"  target="T-rl"  parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="Tf3" value="FK run_id"  style="edgeStyle=orthogonalEdgeStyle;fontSize=9;dashed=1;" edge="1" source="T-ln"  target="T-rl"  parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="Tf4" value="FK run_id"  style="edgeStyle=orthogonalEdgeStyle;fontSize=9;dashed=1;" edge="1" source="T-ps"  target="T-rl"  parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="Tf5" value="FK run_id"  style="edgeStyle=orthogonalEdgeStyle;fontSize=9;dashed=1;" edge="1" source="T-rcl" target="T-rl"  parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
