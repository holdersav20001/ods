        <!-- ECS → Audit -->
        <mxCell id="710" value="emit audit event" style="endArrow=block;endFill=1;strokeColor=#880E4F;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="640" as="sourcePoint"/><mxPoint x="620" y="830" as="targetPoint"/></mxGeometry></mxCell>

        <!-- ECS → CloudWatch -->
        <mxCell id="711" value="metrics" style="endArrow=block;endFill=1;strokeColor=#546E7A;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="620" as="sourcePoint"/><mxPoint x="800" y="830" as="targetPoint"/></mxGeometry></mxCell>

        <!-- Canonical Topic → handoff -->
        <mxCell id="712" value="" style="endArrow=block;endFill=1;strokeColor=#880E4F;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="885" as="sourcePoint"/><mxPoint x="340" y="930" as="targetPoint"/></mxGeometry></mxCell>

