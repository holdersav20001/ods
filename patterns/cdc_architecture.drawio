        </mxCell>

        <!-- P1 column header -->
        <mxCell id="p1-cg" value="&lt;b&gt;P1 Consumer Group&lt;/b&gt;&lt;br/&gt;&lt;font size='2' color='#555'&gt;reads cdc.entity topics&lt;/font&gt;"
