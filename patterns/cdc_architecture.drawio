        <mxCell id="kafka-outbox" value="&lt;b&gt;outbox.events topics&lt;/b&gt;&lt;br/&gt;&lt;font color='#555555' size='2'&gt;keyed by aggregate ID&lt;br/&gt;dedicated P3 topic&lt;/font&gt;"
