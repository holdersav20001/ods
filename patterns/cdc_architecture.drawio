                vertex="1" parent="lane-patterns">
          <mxGeometry x="1000" y="300" width="180" height="90" as="geometry"/>
        </mxCell>

        <!-- Key note -->
        <mxCell id="pattern-note" value="&lt;b&gt;Each pattern is an independent consumer group — all read from the same Kafka topic simultaneously.&lt;/b&gt;&lt;br/&gt;Adding a pattern = adding a consumer group. No change to extraction layer or Kafka topics."
