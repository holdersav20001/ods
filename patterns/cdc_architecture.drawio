        </mxCell>
        <mxCell id="p1-table" value="&lt;b&gt;customers&lt;/b&gt;&lt;br/&gt;&lt;font size='2' color='#555'&gt;one row per entity&lt;br/&gt;last_source_position&lt;br/&gt;per-entity strongly consistent&lt;/font&gt;"
                style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1565C0;fontSize=11;arcSize=15;"
                vertex="1" parent="lane-patterns">
          <mxGeometry x="20" y="300" width="220" height="90" as="geometry"/>
        </mxCell>

        <!-- P2 column -->
        <mxCell id="p2-cg" value="&lt;b&gt;P2 Consumer Group&lt;/b&gt;&lt;br/&gt;&lt;font size='2' color='#555'&gt;reads cdc.entity topics&lt;/font&gt;"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#880E4F;fontSize=11;arcSize=15;"
                vertex="1" parent="lane-patterns">
          <mxGeometry x="265" y="45" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p2-impl" value="&lt;b&gt;Append-Only Log&lt;/b&gt;&lt;br/&gt;&lt;font size='2' color='#555'&gt;INSERT (pk, source_position)&lt;br/&gt;ON CONFLICT DO NOTHING&lt;/font&gt;"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#880E4F;fontSize=11;arcSize=15;"
                vertex="1" parent="lane-patterns">
          <mxGeometry x="265" y="165" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2-table" value="&lt;b&gt;customer_history&lt;/b&gt;&lt;br/&gt;&lt;font size='2' color='#555'&gt;one row per event&lt;br/&gt;(pk, lsn) composite PK&lt;br/&gt;full history preserved&lt;/font&gt;"
