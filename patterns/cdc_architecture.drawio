        </mxCell>

        <mxCell id="kafka-app" value="&lt;b&gt;app.events topics&lt;/b&gt;&lt;br/&gt;&lt;font color='#555555' size='2'&gt;keyed by entity ID&lt;br/&gt;or event type&lt;/font&gt;"
