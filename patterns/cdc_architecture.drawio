        </mxCell>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- ROW 4: PATTERN CONSUMER GROUPS                      -->
        <!-- ═══════════════════════════════════════════════════ -->
        <mxCell id="lane-patterns" value="④ Pattern Consumer Groups — each pattern is an independent consumer group reading from Kafka"
