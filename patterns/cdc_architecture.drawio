        </mxCell>
        <mxCell id="p4-table" value="&lt;b&gt;orders + lines + payments&lt;/b&gt;&lt;br/&gt;&lt;font size='2' color='#555'&gt;all keyed by order_id&lt;br/&gt;cross-table consistent&lt;br/&gt;within aggregate&lt;/font&gt;"
                style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2E7D32;fontSize=11;"
