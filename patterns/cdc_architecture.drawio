                vertex="1" parent="lane-patterns">
          <mxGeometry x="1000" y="45" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p5-impl" value="&lt;b&gt;Staging-Then-Merge&lt;/b&gt;&lt;br/&gt;&lt;font size='2' color='#555'&gt;write raw_cdc_events PENDING&lt;br/&gt;merge procedure applies P1 upsert&lt;/font&gt;"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#E65100;fontSize=11;arcSize=15;"
                vertex="1" parent="lane-patterns">
          <mxGeometry x="1000" y="165" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p5-table" value="&lt;b&gt;raw_cdc_events&lt;/b&gt;&lt;br/&gt;&lt;font size='2' color='#555'&gt;PENDING → PROCESSED&lt;br/&gt;apply_status per event&lt;br/&gt;staging + audit in one table&lt;/font&gt;"
