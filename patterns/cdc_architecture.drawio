          <mxGeometry x="20" y="45" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p1-impl" value="&lt;b&gt;Current-State Upsert&lt;/b&gt;&lt;br/&gt;&lt;font size='2' color='#555'&gt;ON CONFLICT DO UPDATE&lt;br/&gt;LSN guard (WHERE pos &amp;lt; incoming)&lt;/font&gt;"
