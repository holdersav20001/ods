        <!-- P5 column -->
        <mxCell id="p5-cg" value="&lt;b&gt;P5 Consumer Group&lt;/b&gt;&lt;br/&gt;&lt;font size='2' color='#555'&gt;reads cdc.entity topics&lt;/font&gt;"
