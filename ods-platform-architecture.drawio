        <mxCell id="snk-note" value="Offset commit: AFTER snapshot confirmed (Iceberg)&#xa;and AFTER PostgreSQL confirms write (JDBC).&#xa;Connector restart re-reads from last committed offset — safe to reprocess." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f0d000;fontSize=10;align=left;" vertex="1" parent="1">
