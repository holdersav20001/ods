        <mxCell id="e-snk-4" value="schema by ID · cached" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;" edge="1" source="snk-sr" target="snk-jdbc-con" parent="1">
          <mxGeometry relative="1" as="geometry"/>
