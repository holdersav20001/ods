        <!-- Both connectors → Registry -->
        <mxCell id="e-snk-11" value="update status · offset" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="snk-iceberg-con" target="snk-registry" parent="1">
