        <!-- ===== EDGES — Happy Path ===== -->
        <!-- MSK Topic → both connectors -->
        <mxCell id="e-snk-1" value="poll · own&#xa;consumer group" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="snk-msk-src" target="snk-iceberg-con" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-snk-2" value="poll · own&#xa;consumer group" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="snk-msk-src" target="snk-jdbc-con" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Schema Registry → both connectors -->
        <mxCell id="e-snk-3" value="schema by ID · cached" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;" edge="1" source="snk-sr" target="snk-iceberg-con" parent="1">
          <mxGeometry relative="1" as="geometry"/>
