        <mxCell id="523" value="&lt;b&gt;Raw topic consumer offset committed (via EOS transaction)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=9;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="125" y="1749" width="145" height="22" as="geometry"/></mxCell>
        <mxCell id="623" value="offset advanced to next unprocessed record · batch complete · loop back to step 4" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=8;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="125" y="1777" width="145" height="26" as="geometry"/></mxCell>

        <!-- ===== FAILURE F6: ECS crash — restart note ===== -->
        <mxCell id="456" value="ECS crash / restart: Kafka Streams restores RocksDB state from changelog topic · resumes from last committed offset (via EOS) · no manual intervention required for transient failures" style="text;html=1;strokeColor=#C62828;fillColor=#FFCDD2;align=center;verticalAlign=middle;fontSize=8;fontColor=#B71C1C;fontStyle=2;rounded=1;" vertex="1" parent="1"><mxGeometry x="62" y="1820" width="1450" height="26" as="geometry"/></mxCell>

        <!-- ===== FOOTER NOTES ===== -->
        <mxCell id="800" value="↓ Canonical topic ods.{domain}.{dataset} consumed by ods-kafka-sink-connector → Iceberg (S3) + PostgreSQL  (see ods-kafka-sink-sequence)" style="text;html=1;strokeColor=#880E4F;fillColor=#F8BBD9;align=center;verticalAlign=middle;fontSize=9;fontColor=#880E4F;fontStyle=3;rounded=1;" vertex="1" parent="1"><mxGeometry x="62" y="1862" width="1450" height="24" as="geometry"/></mxCell>

        <mxCell id="801" value="⚙ EOS v2: steps 8 (beginTransaction) → 22 (commitTransaction) are atomic. If crash occurs mid-batch, transaction is aborted by broker. ECS restarts from last committed offset. No duplicates on K2. Quarantine records are intentionally outside the transaction to preserve originals for replay." style="text;html=1;strokeColor=#00695C;fillColor=#E0F2F1;align=center;verticalAlign=middle;fontSize=8;fontColor=#004D40;fontStyle=2;rounded=1;" vertex="1" parent="1"><mxGeometry x="62" y="1894" width="1450" height="28" as="geometry"/></mxCell>

        <mxCell id="802" value="⚠ Quarantine topic (replayable): records routed here preserve the original raw CDC payload + failure context. A separate replay service can reprocess quarantined records after config/schema fixes — without re-reading from the source CDC system." style="text;html=1;strokeColor=#E65100;fillColor=#FFE0B2;align=center;verticalAlign=middle;fontSize=8;fontColor=#BF360C;fontStyle=2;rounded=1;" vertex="1" parent="1"><mxGeometry x="62" y="1930" width="1450" height="28" as="geometry"/></mxCell>

        <mxCell id="803" value="↑ See ods-kafka-canonical-overview for high-level phase summary and technology map" style="text;html=1;strokeColor=#856404;fillColor=#fff3cd;align=center;verticalAlign=middle;fontSize=8;fontColor=#533f03;fontStyle=3;rounded=1;" vertex="1" parent="1"><mxGeometry x="62" y="1966" width="1450" height="22" as="geometry"/></mxCell>

