        <mxCell id="618" value="Confluent wire format · canonical Avro · acks=all · idempotent producer · key = business_key_hash (consistent partitioning)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=8;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="280" y="1427" width="1075" height="18" as="geometry"/></mxCell>

