        <mxCell id="322" value="22" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=9;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="30" y="1691" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="422" value="commitTransaction() — atomic: canonical records become visible on K2 AND raw topic consumer offset advanced simultaneously · EOS v2 guarantees" style="text;html=1;strokeColor=none;fillColor=#B2DFDB;strokeColor=#00695C;align=center;verticalAlign=middle;fontSize=8;fontColor=#004D40;fontStyle=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="175" y="1691" width="1080" height="24" as="geometry"/></mxCell>

