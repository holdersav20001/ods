        <mxCell id="620" value="run_id · source_type=cdc · record_count · raw_offset · canonical_topic · scd_type · dq_scores · canonicalize_latency_ms" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=8;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="280" y="1567" width="610" height="18" as="geometry"/></mxCell>

