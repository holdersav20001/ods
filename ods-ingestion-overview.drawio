<mxfile host="Claude">
  <diagram id="ingestion-ov" name="ODS Ingestion Pipeline — Overview">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <!-- TITLE -->
        <mxCell id="10" value="ODS Ingestion Pipeline — SFTP to S3 Curated (Overview)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F5C8B;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1060" height="35" as="geometry"/></mxCell>

        <!-- NAV BAR -->
        <mxCell id="11" value="↔ Sequence: ods-ingestion-sequence  ·  ↓ Downstream: ods-s3-kafka-overview" style="text;html=1;strokeColor=#856404;fillColor=#fff3cd;align=center;verticalAlign=middle;fontSize=8;fontColor=#533f03;fontStyle=3;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="1060" height="22" as="geometry"/></mxCell>

        <!-- SFTP (source) -->
        <mxCell id="101" value="Internal SFTP Server&#xa;(connectivity TBD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontColor=#0D47A1;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="82" width="220" height="50" as="geometry"/></mxCell>

        <!-- ===== DAG 1 · DETECT & TRANSFER ===== -->
        <mxCell id="102" value="1 · Detect &amp; Transfer" style="rounded=1;arcSize=3;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontColor=#F57F17;fontSize=10;fontStyle=1;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="145" width="980" height="430" as="geometry"/></mxCell>

        <!-- SENSOR -->
        <mxCell id="103" value="Airflow SFTP Sensor&#xa;poll interval: 5 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e3e5;strokeColor=#6c757d;fontColor=#383d41;fontSize=9;" vertex="1" parent="1"><mxGeometry x="85" y="190" width="220" height="50" as="geometry"/></mxCell>
        <!-- CAT_PG -->
        <mxCell id="104" value="PostgreSQL&#xa;file_catalogue · approved whitelist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#004085;fontColor=#004085;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="190" width="260" height="50" as="geometry"/></mxCell>
        <!-- STATE_PG -->
        <mxCell id="105" value="PostgreSQL&#xa;ingestion_file_state · idempotency guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#004085;fontColor=#004085;fontSize=9;" vertex="1" parent="1"><mxGeometry x="700" y="190" width="300" height="50" as="geometry"/></mxCell>
        <!-- OP -->
        <mxCell id="106" value="SFTPToS3Operator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontColor=#155724;fontSize=9;" vertex="1" parent="1"><mxGeometry x="85" y="295" width="220" height="50" as="geometry"/></mxCell>
        <!-- S3R -->
        <mxCell id="107" value="S3 Raw Zone&#xa;ods-raw-{env} · permanent archive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#004085;fontColor=#004085;fontSize=9;" vertex="1" parent="1"><mxGeometry x="380" y="340" width="260" height="50" as="geometry"/></mxCell>
        <!-- CHK -->
        <mxCell id="108" value="MD5 Checksum Verification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontColor=#155724;fontSize=9;" vertex="1" parent="1"><mxGeometry x="85" y="400" width="220" height="50" as="geometry"/></mxCell>
        <!-- QUAR -->
        <mxCell id="109" value="S3 Quarantine&#xa;ods-quarantine-{env}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#dc3545;fontColor=#721c24;fontSize=9;" vertex="1" parent="1"><mxGeometry x="700" y="460" width="300" height="50" as="geometry"/></mxCell>
        <!-- DONE -->
        <mxCell id="110" value="already processed · exit" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#dc3545;fontColor=#721c24;fontSize=9;" vertex="1" parent="1"><mxGeometry x="700" y="295" width="200" height="50" as="geometry"/></mxCell>

        <!-- EventBridge (between DAG1 and DAG2) -->
        <mxCell id="111" value="AWS EventBridge&#xa;Object Created trigger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C62828;fontColor=#B71C1C;fontSize=9;" vertex="1" parent="1"><mxGeometry x="420" y="615" width="220" height="50" as="geometry"/></mxCell>

        <!-- ===== DAG 2 · ETL ===== -->
        <mxCell id="112" value="2 · ETL" style="rounded=1;arcSize=3;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1B5E20;fontSize=10;fontStyle=1;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="740" height="250" as="geometry"/></mxCell>
        <!-- CFG -->
        <mxCell id="113" value="S3 Config · versioned&#xa;pin version on trigger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#004085;fontColor=#004085;fontSize=9;" vertex="1" parent="1"><mxGeometry x="85" y="745" width="260" height="50" as="geometry"/></mxCell>
        <!-- GLUE -->
        <mxCell id="114" value="Glue ETL Job&#xa;Schema · CSV→Parquet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontColor=#155724;fontSize=9;" vertex="1" parent="1"><mxGeometry x="430" y="745" width="260" height="50" as="geometry"/></mxCell>
        <!-- S3C -->
        <mxCell id="115" value="S3 Curated Zone&#xa;ods-curated-{env} · partitioned by date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#004085;fontColor=#004085;fontSize=9;" vertex="1" parent="1"><mxGeometry x="85" y="840" width="260" height="50" as="geometry"/></mxCell>
        <!-- CATALOG -->
        <mxCell id="116" value="Glue Data Catalog&#xa;ods_{domain}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e3e5;strokeColor=#6c757d;fontColor=#383d41;fontSize=9;" vertex="1" parent="1"><mxGeometry x="430" y="840" width="260" height="50" as="geometry"/></mxCell>

        <!-- ===== POST-ETL ===== -->
        <mxCell id="117" value="3 · Post-ETL" style="rounded=1;arcSize=3;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D47A1;fontSize=10;fontStyle=1;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="990" width="740" height="145" as="geometry"/></mxCell>
        <!-- AUDIT -->
        <mxCell id="118" value="MSK Audit Topic&#xa;ods.pipeline.audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD9;strokeColor=#880E4F;fontColor=#880E4F;fontSize=9;" vertex="1" parent="1"><mxGeometry x="85" y="1030" width="260" height="50" as="geometry"/></mxCell>
        <!-- DLQ -->
        <mxCell id="119" value="S3 DLQ&#xa;ods-dlq-{env}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#dc3545;fontColor=#721c24;fontSize=9;" vertex="1" parent="1"><mxGeometry x="430" y="1030" width="260" height="50" as="geometry"/></mxCell>

        <!-- EB2 and PUBLISH (handoff to Publish Pipeline) -->
        <mxCell id="120" value="AWS EventBridge&#xa;ods-curated-file-rule-{env}&#xa;Object Created trigger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C62828;fontColor=#B71C1C;fontSize=9;" vertex="1" parent="1"><mxGeometry x="840" y="840" width="220" height="65" as="geometry"/></mxCell>
        <mxCell id="121" value="→ Publish Pipeline&#xa;ods-s3-kafka-overview" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3cd;strokeColor=#856404;fontColor=#533f03;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="840" y="990" width="220" height="50" as="geometry"/></mxCell>

        <!-- ===== EDGES — HAPPY PATH ===== -->
        <!-- SFTP → SENSOR -->
        <mxCell id="201" value="new CSV file" style="endArrow=block;endFill=1;strokeColor=#1565C0;strokeWidth=1.5;" edge="1" source="101" target="103" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- SENSOR → CAT_PG -->
        <mxCell id="202" value="check approved?" style="endArrow=block;endFill=1;strokeColor=#6c757d;strokeWidth=1.5;" edge="1" source="103" target="104" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- CAT_PG → STATE_PG -->
        <mxCell id="203" value="approved" style="endArrow=block;endFill=1;strokeColor=#004085;strokeWidth=1.5;" edge="1" source="104" target="105" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- STATE_PG → OP -->
        <mxCell id="204" value="state=new · proceed" style="endArrow=block;endFill=1;strokeColor=#004085;strokeWidth=1.5;" edge="1" source="105" target="106" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- OP → S3R -->
        <mxCell id="205" value="copy CSV" style="endArrow=block;endFill=1;strokeColor=#28a745;strokeWidth=1.5;" edge="1" source="106" target="107" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- S3R → CHK -->
        <mxCell id="206" value="verify integrity" style="endArrow=block;endFill=1;strokeColor=#004085;strokeWidth=1.5;" edge="1" source="107" target="108" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- CHK → STATE_PG (update transferred) -->
        <mxCell id="207" value="state=transferred" style="endArrow=block;endFill=1;strokeColor=#28a745;strokeWidth=1.5;" edge="1" source="108" target="105" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- S3R → EB -->
        <mxCell id="208" value="Object Created event" style="endArrow=block;endFill=1;strokeColor=#004085;strokeWidth=1.5;" edge="1" source="107" target="111" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- EB → CFG (trigger DAG2) -->
        <mxCell id="209" value="trigger DAG 2" style="endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=1.5;" edge="1" source="111" target="113" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- CFG → GLUE -->
        <mxCell id="210" value="trigger" style="endArrow=block;endFill=1;strokeColor=#28a745;strokeWidth=1.5;" edge="1" source="113" target="114" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- GLUE → S3R (read CSV) -->
        <mxCell id="211" value="read CSV" style="endArrow=block;endFill=1;strokeColor=#28a745;strokeWidth=1.5;" edge="1" source="114" target="107" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- GLUE → S3C -->
        <mxCell id="212" value="write Parquet" style="endArrow=block;endFill=1;strokeColor=#28a745;strokeWidth=1.5;" edge="1" source="114" target="115" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- GLUE → CATALOG -->
        <mxCell id="213" value="register" style="endArrow=block;endFill=1;strokeColor=#28a745;strokeWidth=1.5;" edge="1" source="114" target="116" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- GLUE → AUDIT -->
        <mxCell id="214" value="success" style="endArrow=block;endFill=1;strokeColor=#28a745;strokeWidth=1.5;" edge="1" source="114" target="118" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- S3C → EB2 -->
        <mxCell id="215" value="Object Created event" style="endArrow=block;endFill=1;strokeColor=#004085;strokeWidth=1.5;" edge="1" source="115" target="120" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- EB2 → PUBLISH -->
        <mxCell id="216" value="trigger Publish DAG" style="endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=1.5;" edge="1" source="120" target="121" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== EDGES — FAILURE ===== -->
        <!-- CAT_PG → QUAR (not approved) -->
        <mxCell id="217" value="not approved" style="endArrow=block;endFill=1;dashed=1;strokeColor=#dc3545;strokeWidth=1.5;" edge="1" source="104" target="109" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- STATE_PG → DONE (already processed) -->
        <mxCell id="218" value="state=completed · skip" style="endArrow=block;endFill=1;dashed=1;strokeColor=#dc3545;strokeWidth=1.5;" edge="1" source="105" target="110" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- CHK → QUAR (checksum mismatch) -->
        <mxCell id="219" value="mismatch" style="endArrow=block;endFill=1;dashed=1;strokeColor=#dc3545;strokeWidth=1.5;" edge="1" source="108" target="109" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- GLUE → DLQ (schema fail) -->
        <mxCell id="220" value="schema fail" style="endArrow=block;endFill=1;dashed=1;strokeColor=#dc3545;strokeWidth=1.5;" edge="1" source="114" target="119" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
